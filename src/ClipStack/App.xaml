<Application x:Class="ClipStack.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Popup palette; replaced at runtime by ThemeManager (light/dark + accent). -->
        <SolidColorBrush x:Key="Popup.Background" Color="#F9F9F9" />
        <SolidColorBrush x:Key="Popup.Border" Color="#33000000" />
        <SolidColorBrush x:Key="Popup.Foreground" Color="#1A1A1A" />
        <SolidColorBrush x:Key="Popup.Muted" Color="#6B6B6B" />
        <SolidColorBrush x:Key="Popup.Hover" Color="#0C000000" />
        <SolidColorBrush x:Key="Popup.Selected" Color="#380067C0" />
        <SolidColorBrush x:Key="Popup.SearchBackground" Color="White" />
        <SolidColorBrush x:Key="Popup.Separator" Color="#14000000" />
        <SolidColorBrush x:Key="Popup.Badge" Color="#10000000" />
        <SolidColorBrush x:Key="Popup.Accent" Color="#0067C0" />

        <!-- Context menu styled to match the popup -->
        <Style x:Key="PopupMenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{DynamicResource Popup.Separator}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Popup.Foreground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource Popup.SearchBackground}" BorderBrush="{DynamicResource Popup.Border}"
                                BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="220" Margin="0,0,8,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="Separator" BasedOn="{StaticResource PopupMenuSeparator}" />
            </Style.Resources>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource Popup.Foreground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0"
                                           Foreground="{DynamicResource Popup.Muted}" FontSize="12" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Popup.Selected}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>

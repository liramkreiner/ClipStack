<Window x:Class="ClipStack.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ClipStack.UI"
        Title="ClipStack"
        Width="440" Height="520" MinWidth="300" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="True" WindowStartupLocation="Manual"
        Background="{DynamicResource Popup.Background}"
        Foreground="{DynamicResource Popup.Foreground}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <!-- No caption; thin resize border; a 1px glass frame keeps the native shadow and rounded corners. -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Slim overlay-style scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2,2,2">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" CornerRadius="3" Background="{DynamicResource Popup.Muted}" Opacity="0.45" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Opacity" Value="0.75" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRowClicked" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnRowRightClicked" />
        </Style>

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type ui:RowViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Header}" Margin="16,10,0,4" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Popup.Muted}"
                           Visibility="{Binding HasHeader, Converter={StaticResource BoolToVis}}" />
                <Border x:Name="Card" Margin="6,1" Padding="10,7" CornerRadius="6" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Leading visual: thumbnail for images, else app icon, else type glyph -->
                        <Grid Grid.Column="0" Width="28" VerticalAlignment="Top" Margin="0,1,10,0">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{DynamicResource Popup.Muted}" HorizontalAlignment="Center"
                                       Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}" />
                            <Image Source="{Binding AppIcon}" Width="20" Height="20" HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Image Source="{Binding Thumbnail}" MaxHeight="72" MaxWidth="260" Stretch="Uniform"
                                   HorizontalAlignment="Left" Margin="0,0,0,4"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsImage, Converter={x:Static ui:InverseBoolToVisibility.Instance}}" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Margin="0,1,0,0"
                                       Foreground="{DynamicResource Popup.Muted}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource Popup.Accent}" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                            <Border Background="{DynamicResource Popup.Badge}" CornerRadius="4" Padding="5,1"
                                    Visibility="{Binding ShortcutHint, Converter={x:Static ui:NullToCollapsed.Instance}}">
                                <TextBlock Text="{Binding ShortcutHint}" FontSize="10.5" Foreground="{DynamicResource Popup.Muted}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Popup.Hover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Popup.Selected}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{DynamicResource Popup.Border}" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search -->
            <Border Grid.Row="0" Margin="10,10,10,4" Padding="10,0" CornerRadius="6" Height="36"
                    Background="{DynamicResource Popup.SearchBackground}"
                    BorderBrush="{DynamicResource Popup.Separator}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource Popup.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Search clipboard…" VerticalAlignment="Center"
                               Foreground="{DynamicResource Popup.Muted}" IsHitTestVisible="False" Margin="2,0,0,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource Popup.Foreground}"
                             CaretBrush="{DynamicResource Popup.Foreground}" FontSize="14"
                             TextChanged="OnSearchChanged" />
                    <TextBlock x:Name="PausedBadge" Grid.Column="2" Text="Paused" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Popup.Accent}" Margin="8,0,0,0" Visibility="Collapsed"
                               ToolTip="Clipboard monitoring is paused" />
                </Grid>
            </Border>

            <!-- History -->
            <ListBox x:Name="List" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,0,0,4"
                     Foreground="{DynamicResource Popup.Foreground}"
                     Focusable="False" SelectionMode="Single"
                     ItemContainerStyle="{StaticResource RowContainer}"
                     ItemTemplate="{StaticResource RowTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     KeyboardNavigation.DirectionalNavigation="None" />

            <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Foreground="{DynamicResource Popup.Muted}" Visibility="Collapsed" />

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Popup.Separator}" BorderThickness="0,1,0,0" Padding="14,6,8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterText" FontSize="11" Foreground="{DynamicResource Popup.Muted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Click="OnSettingsClicked" ToolTip="Settings" Focusable="False" Cursor="Hand"
                            Padding="6,3" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Popup.Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource Popup.Muted}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
